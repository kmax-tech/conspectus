#!/bin/bash
# qlpanel launcher — split window: TUI file manager (default yazi) on the left,
# live Quick Look preview on the right. See README.md.
#   qlpanel [command]   # e.g. qlpanel lf  /  qlpanel nnn
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$REPO/.build/release/qlpanel"
[[ -x $BIN ]] || { echo "qlpanel: not built — run $REPO/build.sh" >&2; exit 1; }

cmd="${1:-yazi}"

# For yazi: build an overlay config that only overrides theme.toml so the panel
# follows the system light/dark appearance. Everything else — including the full
# 3-column layout — is symlinked from the live config. The 3rd column is kept on
# purpose: it also does directory look-ahead (contents of the hovered folder),
# which the Quick Look pane does NOT replace. Quick Look is additive: full
# fidelity for files on the right, yazi's own column for look-ahead + text.
if [[ "$cmd" == "yazi" ]]; then
  src="${YAZI_CONFIG_HOME:-$HOME/.config/yazi}"
  ov="$HOME/.cache/qlpanel/yazi-config"
  rm -rf "$ov"; mkdir -p "$ov"
  if [[ -d $src ]]; then
    for entry in "$src"/*; do
      name="$(basename "$entry")"
      # theme.toml is generated below (appearance-following); rest is symlinked.
      [[ "$name" == "theme.toml" ]] && continue
      ln -sfn "$entry" "$ov/$name"
    done
  fi

  # Follow system light/dark: yazi queries the terminal background (qlpanel sets
  # it per appearance) and picks the matching flavor.
  cat > "$ov/theme.toml" <<'TOML'
[flavor]
dark  = "catppuccin-mocha"
light = "catppuccin-latte"
TOML
  export YAZI_CONFIG_HOME="$ov"
fi

exec "$BIN" "$cmd"
