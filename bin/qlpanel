#!/bin/bash
# qlpanel launcher — split window: TUI file manager (default yazi) on the left,
# live Quick Look preview on the right. See README.md.
#   qlpanel [command]   # e.g. qlpanel lf  /  qlpanel nnn
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$REPO/.build/release/qlpanel"
[[ -x $BIN ]] || { echo "qlpanel: not built — run $REPO/build.sh" >&2; exit 1; }

cmd="${1:-yazi}"

# For yazi: build an overlay config where only theme.toml and yazi.toml are
# generated (rest symlinked from the live config):
#   - theme.toml   -> follow the system light/dark appearance
#   - yazi.toml    -> replace previewers with ONLY the folder previewer, so the
#                     3rd column does directory look-ahead but does NOT preview
#                     files (Quick Look on the right handles files). The full
#                     3-column layout is kept.
if [[ "$cmd" == "yazi" ]]; then
  src="${YAZI_CONFIG_HOME:-$HOME/.config/yazi}"
  ov="$HOME/.cache/qlpanel/yazi-config"
  rm -rf "$ov"; mkdir -p "$ov"
  if [[ -d $src ]]; then
    for entry in "$src"/*; do
      name="$(basename "$entry")"
      [[ "$name" == "theme.toml" || "$name" == "yazi.toml" ]] && continue
      ln -sfn "$entry" "$ov/$name"
    done
  fi

  # Follow system light/dark: yazi queries the terminal background (qlpanel sets
  # it per appearance) and picks the matching flavor.
  cat > "$ov/theme.toml" <<'TOML'
[flavor]
dark  = "catppuccin-mocha"
light = "catppuccin-latte"
TOML

  # yazi.toml: live config + a [plugin] previewers override that keeps only the
  # folder previewer. Injected before the first [[plugin.*]] (or after an
  # existing [plugin] table), so files get no 3rd-column preview.
  if [[ -f "$src/yazi.toml" ]]; then
    awk '
      BEGIN { prev = "previewers = [\n\t{ url = \"*/\", run = \"folder\", sync = true },\n]" }
      /^\[plugin\][[:space:]]*$/           { print; print prev; done=1; next }
      /^\[\[plugin/ && !done               { print "[plugin]"; print prev; done=1 }
      { print }
      END { if (!done) { print "[plugin]"; print prev } }
    ' "$src/yazi.toml" > "$ov/yazi.toml"
  else
    printf '[plugin]\npreviewers = [\n\t{ url = "*/", run = "folder", sync = true },\n]\n' > "$ov/yazi.toml"
  fi

  export YAZI_CONFIG_HOME="$ov"
fi

exec "$BIN" "$cmd"
