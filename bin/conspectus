#!/bin/bash
# conspectus launcher — yazi + live Quick Look preview.
#   conspectus [path]         # start dir = path or $HOME; a FILE path starts
#                             # in its parent with the cursor on the file
#                             # (used by indago's M-o "open in conspectus")
#   conspectus split [path]   # two yazi panes (dual-pane copy via cross-yank)
#   conspectus triple [path]  # two yazi panes + preview following the active one
#   conspectus ssh [--sudo] <host>[:<path>]
#   conspectus '/ssh:<host>|sudo:root@<host>:<path>'   # TRAMP spelling
#                             # a remote machine through an sshfs mount,
#                             # unmounted again when the app quits
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"

# sudo transport for `conspectus ssh` (see there): sshfs calls this script as
# its `ssh` with ssh's arguments ending in `-s sftp`. That subsystem request
# is swapped for the sudo command in CONSPECTUS_SUDO_TRANSPORT, and the sudo
# password goes in as the first line of the stream, ahead of sftp itself.
# Handled before anything else, so the overlay config is not rebuilt.
if [[ -n ${CONSPECTUS_SUDO_TRANSPORT:-} ]]; then
  args=("$@")
  n=${#args[@]}
  [[ $n -ge 2 && ${args[n-2]} == -s && ${args[n-1]} == sftp ]] \
    || { echo "conspectus: sudo transport: sshfs called ssh with unexpected arguments: $*" >&2; exit 1; }
  unset 'args[n-1]' 'args[n-2]'
  # ssh never touches sshfs's socket itself: sshfs hands over ONE socket as
  # stdin and stdout, and OpenSSH switches its stdin/stdout to O_NONBLOCK —
  # a flag shared by everyone holding that socket, so a cat reading it would
  # die on EAGAIN. Two relays through fifos instead: `feeder` (password
  # line, then socket → ssh) and `drain` (ssh → socket). The feeder holds
  # the socket open, so when ssh ends (sudo refused a wrong password) it is
  # killed, or sshfs would never see EOF and hang instead of failing.
  feed_dir="$(mktemp -d)"
  mkfifo -m 600 "$feed_dir/in" "$feed_dir/out"
  exec 3<&0 4>&1   # explicit: a background job's stdin would be /dev/null
  { printf '%s\n' "${CONSPECTUS_SUDO_PW:-}"; exec cat; } <&3 > "$feed_dir/in" &
  feeder=$!
  cat < "$feed_dir/out" >&4 &
  drain=$!
  exec 3<&- 4>&-
  rc=0
  ssh "${args[@]}" "$CONSPECTUS_SUDO_TRANSPORT" < "$feed_dir/in" > "$feed_dir/out" || rc=$?
  wait "$drain" || true
  { kill "$feeder" && wait "$feeder"; } 2>/dev/null || true   # quiet: no "Terminated" line
  rm -rf "$feed_dir"
  exit "$rc"
fi

BIN="$REPO/.build/release/conspectus"
[[ -x $BIN ]] || { echo "conspectus: not built — run $REPO/build.sh" >&2; exit 1; }

# Overlay config under YAZI_CONFIG_HOME: the user's live config is symlinked
# in, the bundled conspectus.yazi plugin (hover -> FIFO, panesync-cd) is
# injected, and init.lua is generated to load the user's init first. The
# user's own yazi config is never touched; a machine with NO yazi config at
# all works too (yazi defaults + the bundled plugin).
src="${YAZI_CONFIG_HOME:-$HOME/.config/yazi}"
ov="$HOME/.cache/conspectus/yazi-config"
rm -rf "$ov"; mkdir -p "$ov/plugins"

split_mode=0
[[ "${1:-}" == "split" || "${1:-}" == "-s" ]] && split_mode=1

if [[ -d $src ]]; then
  for entry in "$src"/*; do
    [[ -e $entry ]] || continue   # empty dir: the glob stays literal
    name="$(basename "$entry")"
    case "$name" in theme.toml|yazi.toml|init.lua|plugins) continue ;; esac
    ln -sfn "$entry" "$ov/$name"
  done
  if [[ -d "$src/plugins" ]]; then
    for p in "$src/plugins"/*; do
      [[ -e $p ]] || continue
      ln -sfn "$p" "$ov/plugins/$(basename "$p")"
    done
  fi
fi

# The bundled plugins, straight from the repo: the glue, and cvs.yazi (CVS
# status signs; it calls this build's binary as `--cvs-status`, found via
# CONSPECTUS_BIN).
ln -sfn "$REPO/plugins/conspectus.yazi" "$ov/plugins/conspectus.yazi"
ln -sfn "$REPO/plugins/cvs.yazi" "$ov/plugins/cvs.yazi"

# init.lua: the user's init first (its require()s resolve against the overlay,
# where the user's plugins are symlinked), then the bundled plugin. The
# session setup is what makes yank state cross INSTANCES (the dual-pane
# y-in-one/p-in-the-other promise) — DDS alone only discovers peers, it does
# not sync the yank without it.
{
  [[ -f "$src/init.lua" ]] && echo "dofile(\"$src/init.lua\")"
  echo 'require("session"):setup { sync_yanked = true }'
  echo 'require("conspectus"):setup()'
  echo 'require("cvs"):setup()'
} > "$ov/init.lua"

# theme.toml: follow the system light/dark appearance via the catppuccin
# flavors — but only if they are actually installed; otherwise keep the
# user's own theme (or yazi's default) instead of erroring on a missing flavor.
if [[ -d "$src/flavors/catppuccin-mocha.yazi" && -d "$src/flavors/catppuccin-latte.yazi" ]]; then
  cat > "$ov/theme.toml" <<'TOML'
[flavor]
dark  = "catppuccin-mocha"
light = "catppuccin-latte"
TOML
elif [[ -f "$src/theme.toml" ]]; then
  ln -sfn "$src/theme.toml" "$ov/theme.toml"
fi

# yazi.toml: split keeps the user's full 3-column config. Preview modes
# default to 2 columns ([mgr] ratio = [1, 4, 0] — yazi's own preview column
# hidden, the Quick Look pane is the sole preview); CONSPECTUS_COLUMNS=3
# keeps the user's full config instead, so yazi's look-ahead column shows
# IN ADDITION to the Quick Look pane.
cols="${CONSPECTUS_COLUMNS:-2}"
case "$cols" in
  2|3) ;;
  *) echo "conspectus: CONSPECTUS_COLUMNS must be 2 or 3 (got '$cols') — using 2" >&2; cols=2 ;;
esac
# Always a generated file (never a symlink), because cvs.yazi's fetchers are
# appended below.
if [[ $split_mode -eq 1 || $cols -eq 3 ]]; then
  if [[ -f "$src/yazi.toml" ]]; then cat "$src/yazi.toml" > "$ov/yazi.toml"; else : > "$ov/yazi.toml"; fi
else
  if [[ -f "$src/yazi.toml" ]]; then
    awk '
      /^\[/            { in_mgr = ($0 ~ /^\[mgr\]/) }
      /^\[mgr\]/       { print; print "ratio = [1, 4, 0]"; next }
      in_mgr && /^[[:space:]]*ratio[[:space:]]*=/ { next }
      { print }
    ' "$src/yazi.toml" > "$ov/yazi.toml"
    grep -q '^\[mgr\]' "$ov/yazi.toml" || printf '\n[mgr]\nratio = [1, 4, 0]\n' >> "$ov/yazi.toml"
  else
    printf '[mgr]\nratio = [1, 4, 0]\n' > "$ov/yazi.toml"
  fi
fi

# cvs.yazi as a fetcher for files and directories, like git.yazi. Appended
# array-of-tables entries; a user yazi.toml that defines `prepend_fetchers`
# as an inline array instead would clash here (yazi then refuses the config).
cat >> "$ov/yazi.toml" <<'TOML'

# conspectus: cvs.yazi — CVS status signs (bundled, see plugins/cvs.yazi)
[[plugin.prepend_fetchers]]
url = "*"
run = "cvs"
group = "cvs"

[[plugin.prepend_fetchers]]
url = "*/"
run = "cvs"
group = "cvs"
TOML

export YAZI_CONFIG_HOME="$ov"
export CONSPECTUS_BIN="$BIN"

# --- conspectus ssh -----------------------------------------------------------
# The remote machine's / is mounted with sshfs (macFUSE) under
# $CONSPECTUS_SSH_MOUNTS/<host> and the app starts inside it — every preview,
# picker and opener then works on plain local paths. sshfs runs the user's own
# `ssh`, so ~/.ssh/config (aliases, ControlMaster, keys) applies. Mounting /
# rather than <path> lets two sessions on the same host share one mount and
# lets yazi walk up past the start dir.
#
# Two spellings, one target: scp-style `conspectus ssh [--sudo] host:path`,
# and Emacs TRAMP paths `/ssh:host:path`, `/ssh:host|sudo:[user@]host:path`
# (as the only argument, with or without `ssh` in front).
#
# sudo reads as another user (root by default): sshfs's `ssh` is this
# launcher again (CONSPECTUS_SUDO_TRANSPORT, see the top of the file), which
# starts the server's sftp-server through `sudo -A -u <user>`. The password
# is asked here once and sent as the first line of the stream; a remote
# askpass helper hands it to sudo, so it never appears on a command line.
# That mount is read-only and has its own mount point (<host>-sudo[-<user>]),
# so a slip in yazi cannot delete or overwrite as another user.

# One ssh round trip before mounting: prints the remote $HOME (the start dir
# for a missing, `~` or relative <path>) and, for sudo, the sftp-server path
# plus `nopasswd` / `password` (whether sudo will ask). The script goes in on
# stdin to `sh -s`, so the remote login shell (bash, zsh, fish) doesn't
# matter. Side effects: none on the server (sftp-server -h only prints usage).
ssh_probe() {
  local host=$1 sudo_user=$2
  {
    echo 'printf "%s\n" "$HOME"'
    if [[ -n $sudo_user ]]; then
      cat <<SH
for p in /usr/lib/openssh/sftp-server /usr/libexec/openssh/sftp-server /usr/lib/ssh/sftp-server /usr/libexec/sftp-server; do
  if [ -x "\$p" ]; then
    printf "%s\n" "\$p"
    if LC_ALL=C sudo -n -u $sudo_user -- "\$p" -h </dev/null 2>&1 | grep -q "password is required"; then echo password; else echo nopasswd; fi
    exit 0
  fi
done
echo no-sftp-server
SH
    fi
  } | ssh "$host" sh -s
}

# The remote command the sudo transport runs instead of the sftp subsystem:
# read the password line, write a throwaway askpass helper that prints it,
# exec-free `sudo -A` so the helper is removed afterwards. Wrapped in
# `sh -c '…'` for any login shell, so it holds no single quote or backslash.
sudo_remote_cmd() {
  local sudo_user=$1 sftp_server=$2
  echo "sh -c 'f=\$(mktemp \"\$HOME/.conspectus-askpass.XXXXXX\") || exit 1; echo \"#!/bin/sh\" > \"\$f\"; echo \"exec printenv CONSPECTUS_PW\" >> \"\$f\"; chmod 700 \"\$f\"; IFS= read -r CONSPECTUS_PW; export CONSPECTUS_PW; SUDO_ASKPASS=\"\$f\" sudo -A -p \"\" -u $sudo_user -- $sftp_server; rc=\$?; rm -f \"\$f\"; exit \$rc'"
}

# True when <dir> is a mount point right now.
is_mounted() { mount | grep -qF " on $1 ("; }

# Unmounts what this launcher mounted (sshfs then exits on its own). A mount
# still in use (another conspectus session, a shell cd'd into it) stays and
# says so — never forced. Side effects: umount.
ssh_unmount() {
  local mnt=$1
  is_mounted "$mnt" || return 0
  umount "$mnt" 2>/dev/null \
    || echo "conspectus: $mnt still in use — left mounted (umount $mnt when done)" >&2
}

# A TRAMP path in "$1" sets host, rpath and sudo_user (globals, like the rest
# of this script); anything outside the subset below stops with a message.
parse_tramp() {
  local spec=${1#/ssh:} hop sudo_hop sudo_host
  if [[ $spec == *'|sudo:'* ]]; then
    hop=${spec%%|sudo:*}
    sudo_hop=${spec#*|sudo:}
    [[ $sudo_hop == *:* ]] || { echo "conspectus: no ':' before the path in '$1'" >&2; exit 2; }
    rpath=${sudo_hop#*:}
    sudo_hop=${sudo_hop%%:*}
    sudo_user=root
    sudo_host=$sudo_hop
    if [[ $sudo_hop == *@* ]]; then
      sudo_user=${sudo_hop%%@*}
      sudo_host=${sudo_hop#*@}
      [[ -n $sudo_user ]] || sudo_user=root
    fi
    host=$hop
    [[ -z $sudo_host || $sudo_host == "${hop#*@}" ]] \
      || { echo "conspectus: sudo on another host than the ssh hop ('$sudo_host' vs '${hop#*@}') is not supported" >&2; exit 2; }
  else
    [[ $spec == *:* ]] || { echo "conspectus: no ':' before the path in '$1'" >&2; exit 2; }
    host=${spec%%:*}
    rpath=${spec#*:}
  fi
  [[ $host != *'#'* ]] || { echo "conspectus: TRAMP ports (host#port) are not supported — set Port in ~/.ssh/config" >&2; exit 2; }
  [[ $spec != *'|'*'|'* ]] || { echo "conspectus: only one hop (ssh, then sudo) is supported" >&2; exit 2; }
}

[[ "${1:-}" == /ssh:* ]] && set -- ssh "$@"
if [[ "${1:-}" == "ssh" ]]; then
  shift
  usage="usage: conspectus ssh [--sudo] <host>[:<path>]   or   conspectus '/ssh:<host>[|sudo:[<user>@]<host>]:<path>'"
  sudo_user=""
  if [[ "${1:-}" == "--sudo" ]]; then sudo_user=root; shift; fi
  [[ $# -eq 1 && -n $1 ]] || { echo "$usage" >&2; exit 2; }
  command -v sshfs >/dev/null || { echo "conspectus: 'conspectus ssh' needs sshfs (macFUSE + sshfs)" >&2; exit 1; }
  if [[ $1 == /ssh:* ]]; then
    [[ -z $sudo_user ]] || { echo "conspectus: --sudo and a TRAMP path don't mix — write |sudo: into the path" >&2; exit 2; }
    parse_tramp "$1"
  else
    host="${1%%:*}"
    rpath=""
    [[ $1 == *:* ]] && rpath="${1#*:}"
  fi
  [[ -n $host ]] || { echo "conspectus: no host in '$1'" >&2; exit 2; }
  [[ -z $sudo_user || $sudo_user =~ ^[A-Za-z0-9._-]+$ ]] || { echo "conspectus: odd sudo user '$sudo_user'" >&2; exit 2; }

  probe="$(ssh_probe "$host" "$sudo_user")" \
    || { echo "conspectus: ssh $host failed — check 'ssh $host' on its own" >&2; exit 1; }
  rhome="$(sed -n 1p <<<"$probe")"
  [[ $rhome == /* ]] || { echo "conspectus: $host sent no usable \$HOME (got '$rhome')" >&2; exit 1; }
  case "$rpath" in
    ""|"~") rpath="$rhome" ;;
    "~/"*)  rpath="$rhome/${rpath#"~/"}" ;;
    /*)     ;;
    *)      rpath="$rhome/$rpath" ;;
  esac

  mnt="${CONSPECTUS_SSH_MOUNTS:-$HOME/mnt/ssh}/$host"
  opts="reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,defer_permissions,noappledouble,noapplexattr"
  sudo_env=()
  if [[ -n $sudo_user ]]; then
    sftp_server="$(sed -n 2p <<<"$probe")"
    sudo_state="$(sed -n 3p <<<"$probe")"
    [[ $sftp_server != no-sftp-server ]] || { echo "conspectus: no sftp-server found on $host" >&2; exit 1; }
    [[ $sftp_server =~ ^/[A-Za-z0-9/._-]+$ ]] || { echo "conspectus: odd sftp-server path from $host: '$sftp_server'" >&2; exit 1; }
    pw=""
    if [[ $sudo_state == password ]]; then
      IFS= read -rs -p "[sudo] password for ${host#*@} (to become $sudo_user): " pw \
        || { echo "conspectus: no sudo password given" >&2; exit 1; }
      echo >&2
    fi
    mnt+="-sudo"
    [[ $sudo_user == root ]] || mnt+="-$sudo_user"
    opts+=",ro,ssh_command=$REPO/bin/conspectus"
    sudo_env=(CONSPECTUS_SUDO_TRANSPORT="$(sudo_remote_cmd "$sudo_user" "$sftp_server")" CONSPECTUS_SUDO_PW="$pw")
  fi
  opts+=",volname=$(basename "$mnt")"

  # Reuse a mount another session made (and leave it to that session);
  # otherwise mount now and unmount on the way out. sshfs 2.x under macFUSE 5
  # cannot daemonize once the mount has started ("continuing in foreground")
  # and would block here, so it runs in the foreground (-f) as a background
  # job and the launcher waits for the mount point to appear.
  if is_mounted "$mnt"; then
    echo "conspectus: reusing the existing mount $mnt" >&2
  else
    mkdir -p "$mnt"
    env ${sudo_env[@]+"${sudo_env[@]}"} sshfs "$host:/" "$mnt" -f -o "$opts" &
    sshfs_pid=$!
    trap 'ssh_unmount "$mnt"' EXIT
    trap 'exit 129' HUP
    trap 'exit 143' TERM
    until is_mounted "$mnt"; do
      if ! kill -0 "$sshfs_pid" 2>/dev/null; then
        echo "conspectus: sshfs $host:/ → $mnt failed" >&2
        exit 1
      fi
      sleep 0.2
    done
  fi
  "$BIN" "$mnt$rpath"
  exit
fi

exec "$BIN" "$@"
