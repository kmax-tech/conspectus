#!/bin/bash
# conspectus launcher — TUI file manager + live Quick Look preview.
#   conspectus [command]        # e.g. conspectus lf  /  conspectus nnn
#   conspectus split [command]  # two yazi panes (dual-pane copy via cross-yank)
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$REPO/.build/release/conspectus"
[[ -x $BIN ]] || { echo "conspectus: not built — run $REPO/build.sh" >&2; exit 1; }

# Dual-pane split: each pane keeps its full yazi config (3-column preview), so
# no Quick Look overlay — hand the args straight to the binary.
if [[ "${1:-}" == "split" || "${1:-}" == "-s" ]]; then
  exec "$BIN" "$@"
fi

cmd="${1:-yazi}"

# For yazi: build an overlay config where only theme.toml and yazi.toml are
# generated (rest symlinked from the live config):
#   - theme.toml   -> follow the system light/dark appearance
#   - yazi.toml    -> [mgr] ratio = [1, 4, 0] hides yazi's 3rd column, so the
#                     Quick Look pane is the sole preview (files and folders).
#                     Navigation is done by entering directories (middle column).
#                     Note: Quick Look on a folder shows its icon + metadata,
#                     not its contents (no look-ahead) — an accepted trade for
#                     the extra width and a single preview surface.
if [[ "$cmd" == "yazi" ]]; then
  src="${YAZI_CONFIG_HOME:-$HOME/.config/yazi}"
  ov="$HOME/.cache/conspectus/yazi-config"
  rm -rf "$ov"; mkdir -p "$ov"
  if [[ -d $src ]]; then
    for entry in "$src"/*; do
      name="$(basename "$entry")"
      [[ "$name" == "theme.toml" || "$name" == "yazi.toml" ]] && continue
      ln -sfn "$entry" "$ov/$name"
    done
  fi

  # Follow system light/dark: yazi queries the terminal background (conspectus sets
  # it per appearance) and picks the matching flavor.
  cat > "$ov/theme.toml" <<'TOML'
[flavor]
dark  = "catppuccin-mocha"
light = "catppuccin-latte"
TOML

  # yazi.toml: live config + a [mgr] ratio override hiding the 3rd column.
  if [[ -f "$src/yazi.toml" ]]; then
    awk '
      /^\[/            { in_mgr = ($0 ~ /^\[mgr\]/) }
      /^\[mgr\]/       { print; print "ratio = [1, 4, 0]"; next }
      in_mgr && /^[[:space:]]*ratio[[:space:]]*=/ { next }
      { print }
    ' "$src/yazi.toml" > "$ov/yazi.toml"
    grep -q '^\[mgr\]' "$ov/yazi.toml" || printf '\n[mgr]\nratio = [1, 4, 0]\n' >> "$ov/yazi.toml"
  else
    printf '[mgr]\nratio = [1, 4, 0]\n' > "$ov/yazi.toml"
  fi

  export YAZI_CONFIG_HOME="$ov"
fi

exec "$BIN" "$cmd"
